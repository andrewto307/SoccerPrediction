# Copy to .env and fill in. Only API_FOOTBALL_KEY is required for live data.

# --- API-Football (https://www.api-football.com) ---------------------------
# Free tier ~100 requests/day. Direct host uses the x-apisports-key header.
API_FOOTBALL_KEY=your_api_football_key_here

# --- Provider selection ----------------------------------------------------
# "api_football" (live) or "mock" (local JSON in data/live_samples, no network).
LIVE_PROVIDER=api_football

# --- Competition (defaults target La Liga) ---------------------------------
# API-Football league id: 140 = La Liga. Change to expand to other leagues.
LEAGUE_ID=140
# Season start-year (e.g. 2025 => 2025/26). Leave empty to auto-select by date.
# NOTE: the API-Football FREE plan only allows seasons 2022-2024. To compute form
# from the API on the free plan, set this to an accessible season, e.g. 2024.
SEASON=

# --- Optional tuning -------------------------------------------------------
# CACHE_TTL_SECONDS=900
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# MODEL_PATH=models/cb_final.pkl
# SCALER_PATH=models/form_scaler.pkl
