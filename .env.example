# Copy to .env and fill in. Only API_FOOTBALL_KEY is required for live data.

# --- API-Football (https://www.api-football.com) ---------------------------
# Free tier ~100 requests/day. Direct host uses the x-apisports-key header.
API_FOOTBALL_KEY=your_api_football_key_here

# --- Provider selection ----------------------------------------------------
# "api_football" (live) or "mock" (local JSON in data/live_samples, no network).
LIVE_PROVIDER=api_football

# --- Competition (defaults target La Liga) ---------------------------------
# API-Football league id: 140 = La Liga. Change to expand to other leagues.
LEAGUE_ID=140
# Season start-year (e.g. 2025 => 2025/26). Leave empty to auto-select by date.
# NOTE: the API-Football FREE plan only allows seasons 2022-2024. To compute form
# from the API on the free plan, set this to an accessible season, e.g. 2024.
SEASON=

# --- Security --------------------------------------------------------------
# API-key auth for THIS service's prediction endpoints. If set, callers (incl.
# the Streamlit UI) must send it as the `X-API-Key` header. Leave empty to run
# keyless (local/demo). Generate one with:  openssl rand -hex 32
APP_API_KEY=
# Allowed browser origins for CORS (comma-separated). Only needed if a browser
# app calls the API directly; the Streamlit UI does not. e.g. https://soccer.example.com
CORS_ORIGINS=
# Per-client rate limit on the prediction endpoints (requests per window secs).
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW=60

# --- HTTPS / reverse proxy (docker-compose caddy service) ------------------
# Your public subdomain. Caddy auto-issues a Let's Encrypt cert for it when the
# domain's A record points at this host and ports 80/443 are reachable.
# Defaults to "localhost" (self-signed) for local testing.
DOMAIN=localhost

# --- Optional tuning -------------------------------------------------------
# CACHE_TTL_SECONDS=900
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
# MODEL_PATH=models/cb_final.pkl
# SCALER_PATH=models/form_scaler.pkl
